{
  "displayName": "Atlas - Scheduling Latency SLO Breach",
  "documentation": {
    "content": "Scheduler p95 assignment latency has exceeded the 50ms SLO target defined in ADR-015.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "Scheduling p95 latency above 50ms",
      "conditionPrometheusQueryLanguage": {
        "query": "histogram_quantile(0.95, sum(rate(atlas_scheduler_scheduling_latency_seconds_bucket[10m])) by (le)) > 0.05",
        "duration": "300s",
        "evaluationInterval": "60s"
      }
    }
  ],
  "notificationChannels": ["projects/velrite-tf-test/notificationChannels/18150517277459920691"],
  "alertStrategy": {
    "autoClose": "3600s"
  },
  "combiner": "OR"
}
